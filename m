+static void
+lz4v2_compress (struct buffer *buf, struct buffer work,
+		struct compress_context *compctx,
+		const struct frame* frame)
+{
+  bool compressed;
+  if (buf->len <= 0)
+    return;
+
+   compressed = do_lz4_compress(buf, &work, compctx, frame);
+  if (buf->len <= 0)
