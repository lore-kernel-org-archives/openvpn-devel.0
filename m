+_save_PKG_CONFIG=3D$PKG_CONFIG
+PKG_CONFIG=3D"$PKG_CONFIG --static"
+PKG_CHECK_MODULES($@)
+PKG_CONFIG=3D$_save_PKG_CONFIG[]dnl
+])dnl PKG_CHECK_MODULES_STATIC
